# ==============================================================================
# CONFIGURACIÓN DE ENTORNO — AVEOLOG AI v2.0
# ==============================================================================

# Puerto del servidor (Por defecto 3000 en local / asignado dinámicamente en Render/Vercel)
PORT=3000

# Base de datos PostgreSQL (Neon DB, Supabase o Render PostgreSQL)
# Ejemplo de conexión gratuita con Neon DB (https://neon.tech):
DATABASE_URL="postgresql://aveo_owner:password@ep-cool-sample.us-east-2.aws.neon.tech/aveolog_db?sslmode=require"

# Clave de API de Google Gemini (Para modelo gemini-2.5-flash)
# Consíguela gratis en https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Entorno de ejecución
NODE_ENV=production
